# =========================================================
# Treasury Rate Console Environment Variables (.env)
# =========================================================

# Django Secret Key & Debug Mode
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,trc.auuat.bank.in

# Database Configuration (PostgreSQL for production/UAT)
# If DB_DATABASE is omitted, SQLite (db.sqlite3) is used automatically for local dev
DB_ENGINE=django.db.backends.postgresql
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cookie & HTTPS Security (set to True in production HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://trc.auuat.bank.in

# SAML SSO Configuration
LOGIN_URL=/accounts/login/
SAML_ENTITY_ID=https://trc.auuat.bank.in/saml2/metadata/
XMLSEC_BINARY=/usr/bin/xmlsec1

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PREFIX=Bulk_FD/
S3_ENDPOINT_URL=
