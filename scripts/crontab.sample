# ==============================================================================
# SAMPLE CRONTAB CONFIGURATION (DRAFT ONLY - DO NOT EXECUTE AUTOMATICALLY)
# ==============================================================================
# To install, run: crontab -e
# Then paste one of the following schedules (replace /var/www/treasury with actual project path):
#
# Format:
# m h dom mon dow   command
#
# Option 1: Run once daily at 6:00 AM IST (recommended)
0 6 * * * /var/www/treasury/scripts/cron_rates_refresh.sh >> /var/www/treasury/logs/cron_rates.log 2>&1
#
# Option 2: Run twice daily (6:00 AM and 2:00 PM IST)
0 6,14 * * * /var/www/treasury/scripts/cron_rates_refresh.sh >> /var/www/treasury/logs/cron_rates.log 2>&1
#
# Option 3: Run every 4 hours during business days (Mon-Fri)
0 6,10,14,18 * * 1-5 /var/www/treasury/scripts/cron_rates_refresh.sh >> /var/www/treasury/logs/cron_rates.log 2>&1
# ==============================================================================
